{
	"name": "pi-bouncer",
	"version": "0.1.0",
	"description": "Guards Pi's bash tool: asks before destructive commands, blocks catastrophic ones, with an optional model-judged auto mode",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"bash",
		"safety",
		"guardrails",
		"permissions"
	],
	"license": "MIT",
	"author": "Gage Vander Clay <gvanderclay@gmail.com>",
	"homepage": "https://github.com/gvanderclay/pi-bouncer#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gvanderclay/pi-bouncer.git"
	},
	"bugs": {
		"url": "https://github.com/gvanderclay/pi-bouncer/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@10.33.0",
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"skills",
		"!skills/**/*.test.ts",
		"dist",
		"schema",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"lint": "biome ci .",
		"typecheck": "tsc -p .",
		"test": "node --test 'src/**/*.test.ts' 'skills/**/*.test.ts'",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "pnpm build"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"unbash": "4.0.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@types/node": "26.6.3",
		"ajv": "8.20.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	}
}
