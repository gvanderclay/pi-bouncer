{
	"name": "pi-bouncer",
	"version": "0.1.0",
	"description": "Catches a short, fixed list of dangerous bash actions, in normal, auto or YOLO mode",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"files": [
		"*.ts",
		"rules",
		"scan",
		"skills",
		"README.md"
	],
	"scripts": {
		"test": "node --test test/*.test.ts"
	},
	"dependencies": {
		"unbash": "4.0.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "26.6.3",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	}
}
